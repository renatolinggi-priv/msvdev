Options -Indexes


#@__HCP_END__@#
# Anything after the comment above is left alone

# URL Rewriting für schöne Kalender-URLs
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Leitet /termine auf termine.php um (ohne .php in der URL)
    RewriteRule ^termine$ termine.php [L]
    
    # Leitet /abo auf abo.php um (ohne .php in der URL)
    RewriteRule ^abo$ abo.php [L]

    # Leitet /fragebogen auf fragebogen.php um (öffentliches Umfrageformular)
    RewriteRule ^fragebogen$ fragebogen.php [L]
</IfModule>

# Security-Header (eingefuehrt 05.08.2026). Vorher lieferte die Seite ausser dem
# Session-Cookie keinen einzigen Schutz-Header aus.
#
# Bewusst KEINE Content-Security-Policy: die Codebasis arbeitet durchgehend mit
# Inline-<script> und Inline-<style>. Eine naive CSP wuerde Portal und Admin lahmlegen --
# das ist ein eigenes Projekt, kein Einzeiler.
<IfModule mod_headers.c>
    # HTTPS erzwingen (1 Jahr). Absichtlich OHNE includeSubDomains/preload: das wuerde
    # alle *.msvwilen.ch-Subdomains mitzwingen, auch fremd betriebene.
    Header always set Strict-Transport-Security "max-age=31536000"

    # Kein MIME-Sniffing. Uploads werden ueber api/dokument_download.php und
    # api/foto_serve.php mit per finfo erkanntem Typ ausgeliefert -- der Browser soll
    # den Header nicht ueberstimmen.
    Header always set X-Content-Type-Options "nosniff"

    # Referrer nur innerhalb derselben Herkunft in voller Laenge weitergeben.
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Clickjacking: Einbetten in fremde Seiten verhindern. Geprueft am 05.08.2026 --
    # www.msvwilen.ch bettet nichts von hier per iframe ein. Der PDF-Viewer im Portal
    # (openPortalDoc) nutzt iframes innerhalb derselben Herkunft, SAMEORIGIN genuegt.
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Interne Dokumente (Markdown) nicht ausliefern (eingefuehrt 08.10.2026): Konzepte,
# Changelog, PRODUCT.md/DESIGN.md liegen teils im Docroot, sind aber nicht fuer den Browser
# bestimmt. PHP liest sie weiterhin; gesperrt ist nur der Abruf per HTTP.
<FilesMatch "\.(md|markdown)$">
    Require all denied
</FilesMatch>

# Include-Dateien (*.inc.php) nicht direkt aufrufbar (eingefuehrt 08.10.2026): Sie werden nur
# per include/require geladen und liefen beim Direktaufruf ohne Datenbank oder Login in einen
# Fatal Error (gesehen im php_error.log). PHP bindet sie weiterhin ein; gesperrt ist nur HTTP.
# Neue Endpunkte, die per Browser oder AJAX erreichbar sein sollen, heissen darum nie *.inc.php.
<FilesMatch "\.inc\.php$">
    Require all denied
</FilesMatch>

# Zwischenspeichern (eingefuehrt 16.10.2026, Audit Mitgliederportal). Vorher lieferte der Server fuer CSS/JS keinen
# Cache-Header; der Browser fragte darum bei jedem Seitenwechsel neu nach. Was sich unter derselben Adresse nie
# aendert, bleibt jetzt ein Jahr im Browser:
#   - eigene Dateien mit ?v=filemtime (jede Aenderung ergibt eine neue Adresse; feste ?v=-Nummern gibt es nicht)
#   - Bibliotheken mit Version im Namen (css/lib/, inc/js/lib/: jquery-3.6.0..., bootstrap-5.3.0..., pdfjs-3.11.174/)
#   - Schriften (.woff2)
# Alles andere (PHP-Seiten, sw.js, Manifest, Uploads) bleibt wie bisher.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{QUERY_STRING} (^|&)v=
    RewriteRule \.(css|js)$ - [E=MSV_VERSIONIERT:1]
</IfModule>
<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable" env=MSV_VERSIONIERT
    <FilesMatch "^(jquery|bootstrap|sweetalert2|xlsx)-[0-9][0-9.]*[.-].*\.(css|js)$|^pdf(\.worker)?\.min\.js$|\.woff2$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
